# bak2me API — environment template. Copy to .env (dev) or .env.production (prod)
# and fill in real values. Optional integrations no-op when left blank.

NODE_ENV=development
PORT=4000

# Public URLs
API_PUBLIC_URL=http://localhost:4000
APP_PUBLIC_URL=http://localhost:5173

# Database
MONGO_URI=mongodb://127.0.0.1:27100/back2u
REDIS_URL=

# Auth
JWT_ACCESS_SECRET=change_me
JWT_REFRESH_SECRET=change_me_too
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176
CORS_PREVIEW_REGEX=

# SMS: Arkesel (Ghana). Blank API key => OTP sends no-op (code logged, not texted).
# Inbound callback URL: {API_PUBLIC_URL}/v1/sms/inbound?token={ARKESEL_WEBHOOK_SECRET}
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=bak2me
ARKESEL_WEBHOOK_SECRET=

# AI
ANTHROPIC_API_KEY=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=no-reply@bak2me.com

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Maps
MAPBOX_TOKEN=

# Web push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@bak2me.com

# Mobile push (Expo)
EXPO_ACCESS_TOKEN=

# Payments (Paystack) — QR tag purchases + reward escrow (Ghana)
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Encrypted memory vault
VAULT_MASTER_KEY=

# Error reporting
SENTRY_DSN=
